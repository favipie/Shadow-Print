# Active Python backend configuration; copy to backend/.env and supply local values.
SHADOWPRINT_DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/shadowprint_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&LongAsMax=yes
SHADOWPRINT_API_KEY=replace-with-a-generated-random-server-only-key
SHADOWPRINT_INVESTIGATOR_ID=DEMO-ANALYST
SHADOWPRINT_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Set separately for live tests. Never use shadowprint_db for modifying tests.
# SHADOWPRINT_TEST_DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/shadowprint_api_test?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&LongAsMax=yes
